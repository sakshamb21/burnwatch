# BurnWatch configuration
# Copy to .env and modify as needed

# Data source: "simulated" or "cansat"
BURNWATCH_DATA_SOURCE=simulated

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
BURNWATCH_LOG_LEVEL=INFO

# Storage backend: "sqlite"
BURNWATCH_STORAGE=sqlite

# SQLite database path (relative to project root)
BURNWATCH_DATABASE_PATH=data/local/burnwatch.db

# Simulator defaults
BURNWATCH_SIM_SEED=42
BURNWATCH_SIM_COUNT=200
BURNWATCH_SIM_INTERVAL_MS=2000

# CanSat adapter
# Path to JSONL replay file or serial port for live connection
BURNWATCH_CANSAT_SOURCE=
# Baud rate for serial connection (if applicable)
BURNWATCH_CANSAT_BAUD=9600

# Anomaly detection
BURNWATCH_ANOMALY_THRESHOLD=3.0
BURNWATCH_ANOMALY_MIN_SAMPLES=30
BURNWATCH_ANOMALY_WARMUP_SAMPLES=10

# API
BURNWATCH_API_HOST=127.0.0.1
BURNWATCH_API_PORT=8000

# AWS (optional, leave blank for local-only operation)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_DYNAMODB_TABLE=
